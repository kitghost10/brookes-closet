# Copy to .env.local. NEVER commit real secrets.

# --- Core ---
APP_URL=http://localhost:3000
# Required in production (>= 32 chars). Used to sign media URLs. Generate: openssl rand -base64 48
APP_SECRET=

# --- Database ---
# Leave empty in development to use embedded Postgres (PGlite) stored in .data/pglite.
# Production: any PostgreSQL 14+ (e.g. Supabase connection string). Run `npm run db:migrate`.
DATABASE_URL=

# --- Private media storage ---
# "local" = private filesystem dir (development / single-server only).
# S3-compatible / Supabase Storage adapters are NOT implemented yet (see docs/PROVIDERS.md).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/private-media
MEDIA_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=200

# --- Email ---
# "console" writes to server log + .data/outbox.jsonl (development only).
# A real transactional email provider adapter is required before launch.
EMAIL_DRIVER=console
EMAIL_FROM="Brooke's Closet <no-reply@example.com>"

# --- Payments ---
# "dev_simulation" = fake checkout, cannot charge money, refused when NODE_ENV=production.
# "none" = checkout disabled. No real provider is implemented/approved.
PAYMENTS_PROVIDER=dev_simulation

# --- Livestream ---
# "none" = Coming-soon state. No real provider is implemented/approved.
STREAM_PROVIDER=none

# --- Policy / retention ---
TERMS_VERSION=2026-10-draft
SESSION_TTL_DAYS=14
RETENTION_AUDIT_DAYS=730
RETENTION_REPORT_DAYS=1095
TRUST_PROXY_HEADERS=false

# --- Seed (scripts/seed.ts) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
